    "version": "0.2.0",
    "configurations": [
        {
            "name": "TaxApiSample",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build TaxApiSample",
            "program": "${workspaceFolder}/src/TaxApiSample/bin/Debug/net10.0/TaxApiSample.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "CCH API Workflow Lab",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/CchApiDemo/bin/Debug/net10.0/CchApiDemo.dll",
            "cwd": "${workspaceFolder}/src/CchApiDemo",
            "stopAtEntry": false,
            "justMyCode": true,
            "console": "integratedTerminal",
            "env": {
                "ASPNETCORE_URLS": "http://localhost:5181"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "preLaunchTask": "build CchApiDemo"
        }
    ]
}